# Placeholder names only. Never commit credentials, tokens, account IDs, or TOTP secrets.
# Copy this file to .env for local use after services exist; .env is ignored by Git.

APP_ENV=local
TRADING_MODE=paper
ENABLE_LIVE_ORDERS=false
MARKET_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Local PostgreSQL placeholders
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=alphaoption
POSTGRES_USER=replace_with_local_username
POSTGRES_PASSWORD=replace_with_local_password
DATABASE_URL=postgresql+psycopg://replace_with_local_username:replace_with_local_password@localhost:5432/alphaoption

# Phase 2B backend-only SmartAPI placeholders. Keep values blank here and put
# genuine values only in the ignored local .env. Never use NEXT_PUBLIC_* names.
SMARTAPI_ENABLED=false
SMARTAPI_API_KEY=
SMARTAPI_CLIENT_CODE=
SMARTAPI_PIN=
SMARTAPI_TOTP_SECRET=
SMARTAPI_API_SECRET=
