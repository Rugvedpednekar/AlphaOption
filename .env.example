# Placeholder names only. Never commit credentials, tokens, account IDs, or TOTP secrets.
# Copy this file to .env for local use after services exist; .env is ignored by Git.

APP_ENV=local
TRADING_MODE=paper
ENABLE_LIVE_ORDERS=false
MARKET_TIMEZONE=Asia/Kolkata

# Local PostgreSQL placeholders
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=alphaoption
POSTGRES_USER=replace_with_local_username
POSTGRES_PASSWORD=replace_with_local_password
DATABASE_URL=postgresql+psycopg://replace_with_local_username:replace_with_local_password@localhost:5432/alphaoption

# Future Phase 8 Angel One SmartAPI market-data placeholders. Their presence does
# not authorize live orders. Keep real values only in an ignored .env or approved
# secret store. Never store a TOTP secret in source control.
SMARTAPI_API_KEY=replace_with_api_key
SMARTAPI_CLIENT_CODE=replace_with_client_code
SMARTAPI_PASSWORD=replace_with_password
SMARTAPI_TOTP_SECRET=replace_locally_never_commit
SMARTAPI_REDIRECT_URL=replace_with_redirect_url
